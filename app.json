{
  "expo": {
    "name": "Northstar Recovery",
    "slug": "northstar-recovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "northstar-recovery",
    "icon": "./assets/northstar-app-icon.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5DE0A6"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Northstar Recovery uses your microphone when you join a meeting with audio or video.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Northstar Recovery uses your photo library so you can set an optional profile photo."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northstar.recovery",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Northstar Recovery uses your photo library so you can set an optional profile photo."
      }
    },
    "android": {
      "package": "com.northstar.recovery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/northstar-app-icon.png",
        "backgroundColor": "#101827"
      }
    },
    "extra": {
      "eas": {
        "projectId": "d72ac8a6-9bd3-41c3-b4e4-55c04cc330f7"
      }
    }
  }
}
